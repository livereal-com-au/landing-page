<?xml version="1.0" encoding="UTF-8"?>
<clientConfig version="1.1">
  <emailProvider id="livereal.com.au">
    <domain>livereal.com.au</domain>
    <displayName>LiveReal Email</displayName>
    <displayShortName>LiveReal</displayShortName>

    <incomingServer type="imap">
      <hostname>mail.livereal.com.au</hostname>
      <port>9993</port>
      <socketType>SSL</socketType>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </incomingServer>

    <outgoingServer type="smtp">
      <hostname>mail.livereal.com.au</hostname>
      <port>9587</port>
      <socketType>STARTTLS</socketType>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </outgoingServer>

    <identity>
      <fullName>%NAME%</fullName>
      <organization>LiveReal</organization>
    </identity>
  </emailProvider>
</clientConfig>


